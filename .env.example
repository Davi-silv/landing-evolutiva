# Domínio definitivo, com https e sem barra no final.
# Entra no canonical, no Open Graph, no JSON-LD e no sitemap.
# Trocar o valor exige um novo build.
VITE_SITE_URL=https://evolutivatech.com.br

# Destino real do formulário. O navegador envia um POST com FormData.
# Exemplos: https://formspree.io/f/seu-id ou o endpoint da empresa.
# O servidor precisa aceitar a origem do site (CORS) e responder 2xx só quando gravar os dados.
# Sem esta variável o botão fica desativado e a interface não mostra sucesso.
VITE_LEAD_ENDPOINT=
